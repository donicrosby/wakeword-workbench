if os.path.exists("pyproject.toml") and os.path.exists("src/wakeword_workbench"):
    print("Installing WakeWord Workbench from local source...")
    subprocess.run(["pip", "install", "-e", "."], check=True)
else:
    print("Installing WakeWord Workbench from PyPI...")
    subprocess.run(["pip", "install", "wakeword-workbench"], check=True)
